hosts = ldap://ad-dc.lalilulelo.local
ldap_version = 3
auth_bind = yes
dn = CN=Administrator,CN=Users,DC=LALILULELO,DC=LOCAL
dnpass = datemi30!
base = DC=LALILULELO,DC=LOCAL
pass_filter = (userPrincipalName=%u)
user_filter = (userPrincipalName=%u)
tls = yes
tls_ca_cert_file = /ad-data/private/tls/ca.pem
tls_require_cert = demand
